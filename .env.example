# Copy to .env.local and fill in.

# --- Admin login (required) ---
ADMIN_PASSWORD=change-me
# Long random string used to sign the admin session cookie (32+ characters).
SESSION_SECRET=

# --- Supabase (optional locally, required in production) ---
# Leave empty to run in local mode: data goes to data/store.json and images to public/uploads.
# Local mode is for development only; serverless hosts (Vercel) do not keep files between requests.
SUPABASE_URL=
# Server-side only. Never expose it to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=

# --- AI tools (optional) ---
# Without these the shop shows built-in answers (size from height/weight, canned style tips, simple try-on overlay).
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5
# IMAGE_MODEL=gemini-2.5-flash-image

# --- Live AI try-on (optional) ---
# Without a key the live mirror stays on-device (pose tracking only).
# Decart key (platform.decart.ai): preferred, runs Decart's live try-on model (pinned in src/lib/live-tryon.ts as LIVE_MODEL).
DECART_API_KEY=
# fal.ai key (FAL_API_KEY also works): the fallback, used without a Decart key or when Decart does not hand out a token
# (a session that fails after it started is not moved). fal.ai only hosts the older Lucy 2.1.
FAL_KEY=
# Comma-separated site origins allowed to request live try-on tokens in production, e.g. https://www.example.com
SITE_ORIGIN=

# Free realistic try-on through a public Hugging Face Space (OOTDiffusion). Off unless set to on:
# the model is licensed for non-commercial use only, and photos go to a Space run by a third party.
FREE_TRYON=
# Optional: a Hugging Face token raises the Space's GPU allowance; another Space id can replace the default.
HF_TOKEN=
FREE_TRYON_SPACE=
